# Copy to .env and adjust. The real .env is never committed.
GITLAB_VERSION=19.4.0-ce.0
GITLAB_HOSTNAME=gitlab.tracenull.fyi
GITLAB_EXTERNAL_URL=https://gitlab.tracenull.fyi
GITLAB_HTTP_PORT=80
GITLAB_SSH_HOST=gitlab-ssh.tracenull.fyi
GITLAB_SSH_PORT=2224
# The virtiofs share from the host dataset, mounted in the VM
GITLAB_DATA_DIR=/mnt/infra
